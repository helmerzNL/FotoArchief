# Compose interpolation variables, not a file mounted into the container.
# Import as stack variables in Komodo/Dockhand, or copy beside compose.yaml
# as .env. Required interpolation variables are intentionally empty so Compose
# fails closed.
# Use a verified registry tag/digest, or a CI image loaded on the target daemon.
# Local CI tags are fotoarchief-ci:<source-commit>; do not auto-pull those.
COMPOSE_PROJECT_NAME=fotoarchief
APP_IMAGE=
APP_URL=http://localhost:8080
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=8080
# Dutch is the only supported interface locale in this release.
APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
DEPLOYMENT_MIGRATION_LOCK_TIMEOUT_SECONDS=300
# Production behind TLS termination: set APP_URL to the exact public HTTPS
# origin, list only your reverse proxy IP/CIDR, and force secure cookies.
TRUSTED_PROXIES=
SESSION_SECURE_COOKIE=

# Optional operational alerts. Disabled by default; configure only with an
# operator-owned endpoint and keep secret-bearing webhook URLs outside git.
OPERATIONS_ALERTS_ENABLED=false
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_MINIMUM_SEVERITY=warning
OPERATIONS_ALERT_FAILED_INGEST_THRESHOLD=5
OPERATIONS_ALERT_PENDING_INGEST_THRESHOLD=100

# Persistent routing for the optional local/organisation-owned AI service.
AI_LOCAL_ENDPOINT=

# One-time upgrade import only. Verify the imported provider records in the
# admin UI after deployment, then remove these legacy values.
AI_EXTERNAL_ENABLED=false
AI_EXTERNAL_ENDPOINT=
AI_PROVIDER_REGION=
AI_RETENTION_NOTICE=
AI_EXTERNAL_API_KEY=
AI_EXTERNAL_VISION_MODEL=
AI_EXTERNAL_EMBEDDING_MODEL=
AI_EXTERNAL_COST_CENTS_PER_IMAGE=0
AI_EXTERNAL_COST_CENTS_PER_EMBEDDING=0
AI_EXTERNAL_MONTHLY_BUDGET_CENTS=0

# Legacy native provider values are imported once. Compose maps them identically
# into app, worker and scheduler during the upgrade; enter API keys only in the
# private deployment environment and remove them after verifying the import.
# A positive monthly budget and a conservative cost estimate in eurocents are
# both required before a native provider can process archive content.
AI_OPENAI_ENABLED=false
AI_OPENAI_API_KEY=
AI_OPENAI_VISION_MODEL=gpt-4.1-mini
AI_OPENAI_COST_CENTS_PER_IMAGE=0
AI_OPENAI_MONTHLY_BUDGET_CENTS=0
AI_ANTHROPIC_ENABLED=false
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_VISION_MODEL=claude-sonnet-5
AI_ANTHROPIC_COST_CENTS_PER_IMAGE=0
AI_ANTHROPIC_MONTHLY_BUDGET_CENTS=0
AI_GEMINI_ENABLED=false
AI_GEMINI_API_KEY=
AI_GEMINI_VISION_MODEL=gemini-2.5-flash
AI_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
AI_GEMINI_COST_CENTS_PER_IMAGE=0
AI_GEMINI_COST_CENTS_PER_EMBEDDING=0
AI_GEMINI_MONTHLY_BUDGET_CENTS=0
AI_OPENROUTER_ENABLED=false
AI_OPENROUTER_API_KEY=
AI_OPENROUTER_VISION_MODEL=
AI_OPENROUTER_EMBEDDING_MODEL=
AI_OPENROUTER_COST_CENTS_PER_IMAGE=0
AI_OPENROUTER_COST_CENTS_PER_EMBEDDING=0
AI_OPENROUTER_MONTHLY_BUDGET_CENTS=0

# Required only for the PostgreSQL container. Enter these same values in the
# first-start wizard using host "postgres"; the app does not receive database
# credentials until onboarding stores them privately.
POSTGRES_DB=fotoarchief
POSTGRES_USER=fotoarchief
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
# Optional after onboarding for Redis-compatible queue/cache operation.
REDIS_HOST=valkey

APP_MAX_UPLOAD_BYTES=104857600
APP_MAX_IMAGE_PIXELS=80000000
APP_MAX_BATCH_UPLOAD_FILES=250
# Private TCP ClamAV INSTREAM endpoint. none means explicitly unscanned.
INGEST_SCANNER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30
# Optional Compose profile:
#   COMPOSE_PROFILES=clamav
#   INGEST_SCANNER=clamav
#   CLAMAV_HOST=clamav
# The daemon must accept the 100 MiB app limit plus multipart/protocol margin.
CLAMAV_MAX_FILE_SIZE=110M
CLAMAV_STREAM_MAX_LENGTH=110M
# Legacy informational value: ingest uses fixed CLI timeout 120 / visibility 180.
# Changing this variable does not change the ingest worker timeout.
APP_WORKER_JOB_TIMEOUT_SECONDS=120
# Must exceed the worker timeout, including a safety margin.
REDIS_QUEUE_RETRY_AFTER=180

# Optional OCR; the image includes Tesseract and Dutch/English trained data.
OCR_ENABLED=false
OCR_BINARY=tesseract
OCR_LANGUAGES=nld+eng
OCR_TIMEOUT=60

# CSV request allowance: at least 6291456 bytes through upstream proxies.
# Export response allowance: at least 1073741824 bytes; allow streaming time.
EXCHANGE_MAX_IMPORT_BYTES=5242880
EXCHANGE_MAX_IMPORT_ROWS=5000
EXCHANGE_SYNC_ANALYSIS_BYTES=262144
EXCHANGE_MAX_EXPORT_ASSETS=500
EXCHANGE_MAX_EXPORT_BYTES=1073741824
EXCHANGE_EXPORT_TTL_MINUTES=120
EXCHANGE_DOWNLOAD_TTL_MINUTES=10
# Keep job timeout < stale claim < database queue visibility (180 seconds).
EXCHANGE_JOB_TIMEOUT_SECONDS=120
EXCHANGE_STALE_CLAIM_SECONDS=150
EXCHANGE_ABANDONED_CLAIM_SECONDS=1800

# FotoArchief local deployment environment template
# Copy to .env before running Docker Compose.
# Never commit .env.

APP_NAME=FotoArchief
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=8080
APP_IMAGE=fotoarchief-app:local
APP_DOCKERFILE=Dockerfile
# Production HTTPS/proxy/passkey contract:
# APP_URL must be the exact public origin used in the browser.
# TRUSTED_PROXIES should name only the reverse proxy IP/CIDR; leave empty when
# the app is reached directly. Set SESSION_SECURE_COOKIE=true behind HTTPS.
TRUSTED_PROXIES=
SESSION_SECURE_COOKIE=

# Optional operational alerts. Disabled by default; configure only with an
# operator-owned endpoint and keep secret-bearing webhook URLs outside git.
OPERATIONS_ALERTS_ENABLED=false
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_MINIMUM_SEVERITY=warning
OPERATIONS_ALERT_FAILED_INGEST_THRESHOLD=5
OPERATIONS_ALERT_PENDING_INGEST_THRESHOLD=100

# AI is disabled by default. Endpoints are non-secret routing settings; API
# credentials belong in private runtime secret stores, never in git.
AI_LOCAL_ENDPOINT=
AI_EXTERNAL_ENDPOINT=
AI_PROVIDER_REGION=
AI_RETENTION_NOTICE=

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Required only for the PostgreSQL container. Enter these same values in the
# first-start wizard using host "postgres"; the app does not read them before
# onboarding completes.
POSTGRES_DB=fotoarchief
POSTGRES_USER=fotoarchief
DB_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_VERSION=16-alpine

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
DB_QUEUE_RETRY_AFTER=180
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=null
VALKEY_VERSION=7-alpine
VALKEY_BIND_ADDRESS=127.0.0.1
VALKEY_PORT=6379
REDIS_QUEUE_RETRY_AFTER=180

WORKER_REPLICAS=1

# Optional ClamAV TCP INSTREAM endpoint on a private trusted network.
# "none" explicitly leaves files unscanned; it never grants publication rights.
INGEST_SCANNER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Optional local Tesseract OCR. Docker includes Dutch and English trained data.
# PHP hosting requires an installed executable and permission to start processes.
OCR_ENABLED=false
OCR_BINARY=tesseract
OCR_LANGUAGES=nld+eng
OCR_TIMEOUT=60

# Optional after onboarding if an operator deliberately switches queue/cache to
# Redis-compatible Valkey. Database queues and file cache/sessions are the
# default for constrained installs. Photo ingest always uses the transactional
# database "ingest" queue: php artisan queue:work ingest --timeout=120.

ARCHIVE_ORIGINALS_PREFIX=originals/
ARCHIVE_DERIVATIVES_PREFIX=derivatives/
ARCHIVE_QUARANTINE_PREFIX=quarantine/
ARCHIVE_EXPORTS_PREFIX=exports/
ARCHIVE_BACKUPS_PREFIX=backups/

# Explicit upload and processing limits. Every reverse proxy, CDN, load
# balancer, PHP runtime and worker host in front of the app must allow at least
# these values when operators raise them.
APP_MAX_UPLOAD_MB=100
APP_MAX_UPLOAD_BYTES=104857600
APP_MAX_IMAGE_PIXELS=80000000
APP_MAX_BATCH_UPLOAD_FILES=250
APP_UPLOAD_TIMEOUT_SECONDS=300
# Legacy informational value: ingest uses fixed CLI timeout 120 / visibility 180.
# Changing this variable does not change the ingest worker timeout.
APP_WORKER_JOB_TIMEOUT_SECONDS=120

# CSV metadata exchange. Uploaded CSV files are bounded before they are read;
# every layer in front of the app (reverse proxy, CDN, ingress) must allow at
# least 6 MiB (6291456 bytes) per request for a 5 MiB import to arrive.
EXCHANGE_MAX_IMPORT_BYTES=5242880
EXCHANGE_MAX_IMPORT_ROWS=5000
EXCHANGE_SYNC_ANALYSIS_BYTES=262144
# Exports. A metadata or ZIP export is built by the ingest worker, stored in
# private storage and released through a personal, short-lived download link;
# there is no public or direct storage URL. EXCHANGE_MAX_EXPORT_BYTES is the
# largest artifact the app will build (1 GiB); a download of that size has to
# survive every layer in front of the app, so a reverse proxy, CDN or ingress
# must allow a response body of at least 1073741824 bytes and a read timeout
# long enough to stream it. Expired artifacts are deleted by the scheduler
# (or manually with: php artisan exchange:prune-exports).
EXCHANGE_MAX_EXPORT_ASSETS=500
EXCHANGE_MAX_EXPORT_BYTES=1073741824
EXCHANGE_EXPORT_TTL_MINUTES=120
EXCHANGE_DOWNLOAD_TTL_MINUTES=10
# Recovery after a stopped worker. An import or export that is being processed
# is claimed by the worker; a worker that is killed, restarted or timed out
# leaves that claim behind. These values must keep the order
#   EXCHANGE_JOB_TIMEOUT_SECONDS < EXCHANGE_STALE_CLAIM_SECONDS < retry_after
# where retry_after is 180 seconds for the ingest queue. Above retry_after the
# redelivered job arrives too early to take the run over and the import or
# export stays "bezig" for ever; below the job timeout a job that is still
# running would be taken over twice. Runs that no job is left for are reported
# as failed after EXCHANGE_ABANDONED_CLAIM_SECONDS by the scheduler (or
# manually with: php artisan exchange:prune-exports and exchange:recover-imports).
EXCHANGE_JOB_TIMEOUT_SECONDS=120
EXCHANGE_STALE_CLAIM_SECONDS=150
EXCHANGE_ABANDONED_CLAIM_SECONDS=1800